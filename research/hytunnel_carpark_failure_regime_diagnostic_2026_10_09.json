  "findings": [
    {
      "id": "F1",
      "finding": "The measured concentration traces extend beyond the common support of source flow and ventilation channels; the frozen model is evaluated only where all channels interpolate to finite values.",
      "evidence": "case_support_summary.common_support_* and source_to_sensor_end_gap_s",
      "implication": "The screen does not evaluate the late sensor tail and should not be interpreted as a complete release-duration prediction."
    },
    {
      "id": "F2",
      "finding": "Short constant-flow experiments and long blowdown experiments occupy different source-duration and ventilation regimes.",
      "evidence": "regimes.short_release_cases vs regimes.long_blowdown_cases",
      "implication": "A single spatially lumped model can pass the middle regime while failing low-flow or long-blowdown behavior."
    },
    {
      "id": "F3",
      "finding": "The frozen model has no spatial plume, buoyancy, detector-position, enclosure-wall, or 3.86 m discharge-line transient state.",
      "evidence": "holdout protocol locked_models and claim boundary",
      "implication": "Peak and duration errors are model-form diagnostics, not a basis for tuning station consequence distances."
    },
    {
      "id": "F4",
      "finding": "Local real-gas aperture mass-flow prediction is closer than concentration transfer but the frozen aggregate mass-flow claim still fails its joint endpoint.",
      "evidence": "holdout result mass_flow claim false",
      "implication": "Use only as a bounded local source-rate diagnostic."
    }
  ],
  "claim_boundary": "This diagnostic explains why the public HyTunnel holdout is not an external validation pass. It does not validate outdoor HRS dispersion, detector placement, consequence distance, station controls, vehicle fueling, or any site-specific safety distance."
}
